{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.ya?ml$/",
      "/(^|/)manifests/.+\\.ya?ml$/",
      "/(^|/)deploy/.+\\.ya?ml$/",
      "/(^|/)deployments/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "kubernetes images (non-major)",
      "addLabels": ["patch", "dont-release"]
    },
    {
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["minor", "dont-release"]
    }
  ]
}

{
  customManagers: [
    // --- Track tool versions in .tool-versions (asdf) ---
    // Annotate each tool with a renovate comment on the line above:
    //   # renovate: datasource=github-releases depName=goreleaser/goreleaser
    //   goreleaser 2.4.1
    //
    //   # renovate: datasource=github-releases depName=nodejs/node versioning=node
    //   nodejs 22.5.1
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.tool-versions$/"],
      matchStrings: [
        "#\\s*renovate:\\s+datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?\\n\\w+\\s+(?<currentValue>\\S+)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
  ],
  packageRules: [
    // --- Group non-major .tool-versions updates ---
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["**/.tool-versions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "asdf tools (non-major)",
      addLabels: ["patch", "dont-release"],
    },
    // --- Major .tool-versions bumps get individual PRs ---
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["**/.tool-versions"],
      matchUpdateTypes: ["major"],
      addLabels: ["minor", "dont-release"],
    },
  ],
}

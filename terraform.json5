{
  "terraform": {
    "pinDigests": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "terraform",
        "terragrunt"
      ],
      "matchDepTypes": [
        "provider"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "terraform providers (non-major)",
      "addLabels": [
        "patch"
      ]
    },
    {
      "matchManagers": [
        "terraform",
        "terragrunt"
      ],
      "matchDepTypes": [
        "module"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "terraform modules (non-major)",
      "addLabels": [
        "patch"
      ]
    },
    {
      "matchManagers": [
        "terraform",
        "terragrunt"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "addLabels": [
        "patch"
      ]
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "poetry": {
    "rangeStrategy": "update-lockfile"
  },
  "pipenv": {
    "rangeStrategy": "update-lockfile"
  },
  "pip-compile": {
    "rangeStrategy": "update-lockfile"
  },
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements",
        "pip_setup",
        "pipenv",
        "poetry",
        "pep621",
        "pip-compile"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "python packages (non-major)",
      "addLabels": ["patch"]
    },
    {
      "matchManagers": [
        "pip_requirements",
        "pip_setup",
        "pipenv",
        "poetry",
        "pep621",
        "pip-compile"
      ],
      "matchUpdateTypes": ["major"],
      "addLabels": ["minor"]
    },
    {
      "matchManagers": ["pyenv"],
      "addLabels": ["minor"]
    }
  ]
}

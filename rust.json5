{
  "cargo": {
    "rangeStrategy": "update-lockfile"
  },
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "rust crates (non-major)",
      "addLabels": [
        "patch"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "addLabels": [
        "patch"
      ]
    }
  ]
}

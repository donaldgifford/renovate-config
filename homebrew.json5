{
  "packageRules": [
    {
      "matchManagers": [
        "homebrew"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "homebrew formulae (non-major)",
      "addLabels": [
        "patch",
        "dont-release"
      ]
    },
    {
      "matchManagers": [
        "homebrew"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "minor"
      ]
    }
  ]
}

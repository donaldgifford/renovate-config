{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "addLabels": [
        "dont-release"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github actions (non-major)",
      "addLabels": [
        "patch"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchPackageNames": [
        "actions/**",
        "github/**",
        "docker/**"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "dont-release"
      ]
    },
    {
      "matchFileNames": [
        ".github/**",
        "Makefile"
      ],
      "addLabels": [
        "dont-release"
      ]
    }
  ]
}
